# WebtiqAI backend settings
# Copy this file to ".env" (same folder) and fill in your key.
# Never share or commit the .env file - it holds your secret key.

# Get a key from https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Optional settings
OPENAI_MODEL=gpt-4o-mini
BUSINESS_NAME=WebtiqAI Store
PORT=5000
